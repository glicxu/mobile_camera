<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <application>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.dali.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/dali_file_paths" />
        </provider>
    </application>
</manifest>
